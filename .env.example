POSTGRES_USER=pa
POSTGRES_PASSWORD=pa
POSTGRES_DB=pa

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# SSO "Se connecter avec Google" — créer un client OAuth sur
# https://console.cloud.google.com/apis/credentials (type "Application Web")
# URI de redirection : http://localhost:8081/realms/pa-tournament/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SSO Discord — créer une app sur https://discord.com/developers/applications
# Redirect : http://localhost:8081/realms/pa-tournament/broker/discord/endpoint
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---- Worker (Pub/Sub) ----
# En local, le worker a besoin soit d'un abonnement réel (avec
# GOOGLE_APPLICATION_CREDENTIALS), soit de l'émulateur Pub/Sub :
#   gcloud beta emulators pubsub start --host-port=0.0.0.0:8085
#   PUBSUB_EMULATOR_HOST=host.docker.internal:8085
GCP_PROJECT_ID=pa-local
PUBSUB_SUBSCRIPTION_DEMANDS=projects/pa-local/subscriptions/pa-local-worker-demandes
PUBSUB_TOPIC_RESPONSES=projects/pa-local/topics/pa-local-reponses
PUBSUB_EMULATOR_HOST=
RUST_LOG=info
