POSTGRES_USER=pa
POSTGRES_PASSWORD=pa
POSTGRES_DB=pa

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# SSO "Se connecter avec Google" — créer un client OAuth sur
# https://console.cloud.google.com/apis/credentials (type "Application Web")
# URI de redirection : http://localhost:8081/realms/pa-tournament/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SSO Discord — créer une app sur https://discord.com/developers/applications
# Redirect : http://localhost:8081/realms/pa-tournament/broker/discord/endpoint
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
